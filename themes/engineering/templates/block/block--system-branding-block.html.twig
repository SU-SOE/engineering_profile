{#
/**
 * @file
 * Site branding block rendered through the jumpstart_ui:lockup SDC.
 *
 * Mirrors stanford_basic's block--system-branding-block.html.twig. The only
 * Engineering customization is the custom logo cell: the centennial logo is
 * decorative (alt="" + aria-hidden) and the link's accessible name comes from
 * the visually hidden centennial text.
 *
 * Available variables:
 *
 * site_logo: Logo for site as defined in Appearance or theme settings.
 * site_name: Name for site as defined in Site information settings.
 * site_slogan: Slogan for site as defined in Site information settings
 * content: Containts the above vars with more information.
 * lockup: Settings from the theme.
 * use_logo: Setting from the theme
 * configuration: More settings from the theme.
 * - id: "system_branding_block"
 * - label: "Site Branding"
 * - use_site_logo: boolean
 * - use_site_name: boolean
 * - use_site_slogan: boolean
 */
#}

{# Set some of the default options for the lockup. #}
{#
  Keep the block classes off the lockup wrapper, as the decanter lockup did,
  but keep contextual-region. Contextual adds that class only for users who
  can use contextual links, so anonymous markup does not change.
#}
{% set has_contextual_region = attributes.hasClass('contextual-region') %}
{% set attributes = attributes|without('class') %}
{% if has_contextual_region %}
  {% set attributes = attributes.addClass('contextual-region') %}
{% endif %}
{% set link = url('<front>') %}
{% if lockup %}
  {% set line3 = lockup.line3 %}
  {% set line4 = lockup.line4 %}
  {% set line5 = lockup.line5 %}
{% endif %}

{# Do not default the line 1 on variant O, S, or T #}
{% if lockup.option != "o" and lockup.option != "s" and lockup.option != "t" %}
  {% set line1 = content.site_name %}
{% endif %}

{# Grab the site1 variable if it is not empty #}
{% if lockup.line1 %}
 {% set line1 = lockup.line1 %}
{% endif %}

{# Default from the theme is to use the site slogan. #}
{% set line2 = site_slogan %}
{% if lockup.line2 %}
 {% set line2 = lockup.line2 %}
{% endif %}

{# Enforce no lines on none. #}
{% if lockup.option == 'none' %}
  {% set line1 = '' %}
  {% set line2 = '' %}
  {% set line3 = '' %}
  {% set line4 = '' %}
  {% set line5 = '' %}
{% endif %}

{% embed 'jumpstart_ui:lockup' with {
  lockup_style: lockup.option,
  line1: line1,
  line2: line2,
  line3: line3,
  line4: line4,
  line5: line5
} %}

  {# If the theme has a custom logo, use it. The logo is decorative; the sr-only text names the link. #}
  {% block cell1 %}
    {% if site_logo and not use_logo %}
      <div class="su-lockup__logo-wrapper">
        <img src="{{ site_logo }}" alt="" class="su-lockup__custom-logo" aria-hidden="true" />
        <span class="sr-only">100 Stanford Engineering 1925–2025. A Century of Discovery, Innovation, and Impact</span>
        {% if line4 %}
          <span class="su-lockup__line4">{{ line4 }}</span>
        {% endif %}
      </div>
    {% else %}
      <div class="su-lockup__wordmark-wrapper">
        <span class="su-lockup__wordmark">Stanford</span>
        {% if line4 %}
          <span class="su-lockup__line4">{{ line4 }}</span>
        {% endif %}
      </div>
    {% endif %}
  {% endblock %}

  {# Override block cell2 because we want to hide some elements if the none option is selected. #}
  {% block cell2 %}
    {% if lockup.option != 'none' %}
      {% if line1 or line2 or line3 %}
      <div class="su-lockup__cell2">
        {% if line1 is not empty %}
        <span class="su-lockup__line1">{{ line1 }}</span>
        {% endif %}

        {% if line2 is not empty %}
        <span class="su-lockup__line2">{{ line2 }}</span>
        {% endif %}

        {% if line3 is not empty %}
        <span class="su-lockup__line3">{{ line3 }}</span>
        {% endif %}
      </div>
      {% endif %}
    {% endif %}
  {% endblock %}

{% endembed %}
