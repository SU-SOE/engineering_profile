{#
/**
 * @file
 * Page title banner paragraph, engineering version.
 *
 * Same as stanford_basic's template, plus the banner style class chosen in the
 * react_paragraphs:page_title_variant_info behavior (SOEOPS-664). soe_basic
 * used to add it from hook_preprocess_ds_entity_view(), which no longer runs.
 * The gradient styles live in soe_basic (theme/_background-classes.scss).
 */
#}
{%- set banner_style = paragraph.getBehaviorSetting('react_paragraphs:page_title_variant_info', 'banner_style') -%}
{%- if banner_style is not empty -%}
  {%- set attributes = attributes.addClass(banner_style|clean_class) -%}
{%- endif -%}
<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("jumpstart_ui:hero", {
    header_tag: "h1",
    image: content.su_title_banner_image,
    headline: drupal_title(),
    show_card: true
  }, with_context = false) }}
  {{ title_suffix }}
</div>
