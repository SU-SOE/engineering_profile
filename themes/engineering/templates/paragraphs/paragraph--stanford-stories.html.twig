{#
/**
 * @file
 * Engineering override of soe_basic's paragraph--stanford-stories.
 *
 * Same as soe_basic, except the quote. soe_paragraphs:soe_story prints the
 * quote inside its own <p>, and the processed text already starts with a
 * <p>, which gave invalid nested paragraphs. Strip the tags first, as the old
 * stories-paragraph pattern on production did (quote|render|striptags), then
 * decode the entities so they display as characters.
 */
#}
{% set heading_behavior = paragraph.su_heading_lvl.value|default("h2")|split(".") %}
{#
  striptags leaves the text's HTML entities encoded, and the component
  autoescapes the plain string again, so an "&" would display as the text
  "&amp;". Decode the entities the text formats produce (filter_html,
  filter_html_escape, CKEditor) back to characters and let autoescape encode
  them once. strtr-based replace runs in one pass, so "&amp;lt;" correctly
  becomes the text "&lt;". No markup is passed through unescaped.
#}
{% set quote = paragraph.stanford_stories_quote.processed|render|striptags|trim|replace({
  "&amp;": "&",
  "&lt;": "<",
  "&gt;": ">",
  "&quot;": "\"",
  "&#34;": "\"",
  "&#039;": "'",
  "&#39;": "'",
  "&apos;": "'",
  "&nbsp;": "\xC2\xA0",
  "&#160;": "\xC2\xA0",
  "&#xA0;": "\xC2\xA0",
}) %}

<div{{ attributes }}>
  {{ title_prefix }}
  {{ include("soe_paragraphs:soe_story", {
    header_tag: heading_behavior.0,
    header_classes: heading_behavior|slice(1)|join(" "),
    border_color: paragraph.stanford_stories_border.value,
    name: paragraph.stanford_stories_name.value,
    title: paragraph.stanford_stories_title.value,
    quote: quote,
    story_link_url: paragraph.stanford_stories_node_link.get(0).getUrl().toString(),
    story_link_text: paragraph.stanford_stories_node_link.title,
    cta_link_url: paragraph.stanford_stories_cta_link.get(0).getUrl().toString(),
    cta_link_title: paragraph.stanford_stories_cta_link.title,
    image: content.stanford_stories_photo
  }, with_context = false) }}
  {{ title_suffix }}
</div>
