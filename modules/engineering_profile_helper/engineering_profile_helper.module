<?php

/**
 * @file
 * Contains engineering_profile_helper.module.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Render\Markup;
use Drupal\Component\Utility\Html;
use Drupal\Core\Entity\Display\EntityViewDisplayInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\engineering_profile_helper\LayoutBuilderCompatibility;

/**
 * Implements hook_help().
 */
function engineering_profile_helper_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the engineering_profile_helper module.
    case 'help.page.engineering_profile_helper':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Engineering Profile Helper module') . '</p>';
      $output .= '<p>' . t('This module holds helper code specifically for the engineering_profile.') . '</p>';
      return $output;

    default:
  }
}

/**
 * @param $form
 * @param $form_state
 *
 */
function engineering_profile_form_views_exposed_form_alter(&$form, &$form_state){
  // Changes the label of the first item on dropdown for exposed filter on /spotlight
  if($form["#id"] == 'views-exposed-form-spotlights-block-1'){
    $form['tid']['#options']["All"] = t('All Departments');
    $form['tid_1']['#options']["All"] = t('All People');
  }
}

/**
 * Implements hook_preprocess_views_view_field().
 */
function engineering_profile_helper_preprocess_views_view_field(&$vars){
  if (isset($vars['view']) && ($vars['view']->id() == 'spotlights')) {
    if ($vars['field']->field == 'su_people_spotlight_quote') {
      // Modify the field for the regular view
      // The block_1 output is wrapped in <div class="soe-quote"> by the
      // field's "Rewrite results" text, and the block_2 output is wrapped in
      // <div class="spotlight__quote"> by its formatter. Trim only the text
      // inside the wrapper so the markup stays intact.
      if (in_array($vars['view']->current_display, ['block_1', 'block_2'])) {
        $vars['output'] = Markup::create(_engineering_profile_helper_trim_spotlight_quote_markup((string) $vars['output']));
      }

      // Modify the field for the inclusion on the Magazine page.
      if ($vars['view']->current_display == 'block_4') {
        $original_content = $vars['output'];
        $new_string = _engineering_profile_helper_modify_spotlight_quote_for_magazine($original_content);
        $vars['output'] = Markup::create($new_string);
      }
    }
  }
}

/**
 * Trim down content for Spotlight quotes for use in Views.
 *
 * @param string $quote The full string value to truncate
 * @return string
 */
function _engineering_profile_helper_trim_spotlight_quote(string $quote) {
  // Add an ellipsis and return.
  return _engineering_profile_helper_shorten_spotlight_quote($quote) . ' &hellip;';
}

/**
 * Shorten a Spotlight quote to 100 characters, without adding an ellipsis.
 *
 * @param string $quote
 *   The full string value to truncate.
 *
 * @return string
 *   The quote cut at a word boundary, without trailing ?!. punctuation.
 */
function _engineering_profile_helper_shorten_spotlight_quote(string $quote): string {
  // Break the string at 100 characters, and explode that into an array.
  $string_array = explode("::", wordwrap(trim($quote), 100, "::"));
  // Take the first element of the array, and trim any EOL punctuation.
  return trim($string_array[0], '?!.');
}

/**
 * Trim the text inside the first <div> of a rendered Spotlight quote.
 *
 * @param string $markup
 *   The rendered field output, e.g. '<div class="soe-quote">Quote</div>'.
 *
 * @return string
 *   The markup with the text of the first <div> trimmed. Markup without a
 *   <div> is reduced to its escaped, trimmed text content. Empty markup is
 *   returned unchanged.
 */
function _engineering_profile_helper_trim_spotlight_quote_markup(string $markup): string {
  if (trim($markup) === '') {
    return $markup;
  }
  $html = Html::load($markup);
  $div = $html->getElementsByTagName('div')->item(0);
  if (!$div) {
    // Trim the decoded text rather than the raw markup, so a cut can't leave
    // unclosed tags or broken entities, and escape it for safe output.
    $body = $html->getElementsByTagName('body')->item(0);
    $text = _engineering_profile_helper_shorten_spotlight_quote($body ? $body->textContent : '');
    return Html::escape($text) . ' &hellip;';
  }
  // Replace the children with an escaped text node and an &hellip; entity, so
  // the quote text can't be re-parsed as markup or entities.
  $text = _engineering_profile_helper_shorten_spotlight_quote($div->textContent);
  while ($div->firstChild) {
    $div->removeChild($div->firstChild);
  }
  $div->appendChild($html->createTextNode($text . ' '));
  $div->appendChild($html->createEntityReference('hellip'));
  return $html->saveHTML($div);
}

function _engineering_profile_helper_modify_spotlight_quote_for_magazine(string $html): string {
  // Return early if the HTML is empty to avoid DOMDocument ValueError in PHP 8.1+.
  if (empty(trim($html))) {
    return '';
  }

  $doc = new DOMDocument();

  // Load the HTML fragment without adding <html> and <body>
  @$doc->loadHTML(mb_convert_encoding($html, 'HTML-ENTITIES', 'UTF-8'), LIBXML_NOERROR | LIBXML_HTML_NOIMPLIED | LIBXML_HTML_NODEFDTD);

  $divs = $doc->getElementsByTagName('div');
  foreach ($divs as $div) {
      if ($div->hasAttribute('class') && $div->getAttribute('class') === 'spotlight__quote') {
          // Get and modify the text content
          $textContent = trim($div->textContent);
          if (substr($textContent, -1) === '.') {
              $textContent = rtrim($textContent, '.');
          }

          // Replace named entities with numeric references
          $modifiedHtml = "&#8220;" . htmlspecialchars($textContent, ENT_NOQUOTES, 'UTF-8') . "&#8230;&#8221;";

          // Clear existing div content
          while ($div->firstChild) {
              $div->removeChild($div->firstChild);
          }

          // Create a new fragment and append XML safely
          $fragment = $doc->createDocumentFragment();
          $fragment->appendXML($modifiedHtml);
          $div->appendChild($fragment);
      }
  }

  // Return clean modified HTML
  return $doc->saveHTML();
}

/**
* Implements hook_preprocess_HOOK().
*/
function engineering_profile_helper_preprocess_spotlight_header_layout(&$vars) {
  if (!empty($vars['content']['spotlight_hero_text'])) {
    // In the case there is a degree and department, we need to merge them together
    // on to a single line. We do so here so as not to break the Layout for the node page.

    $spotlight_hero_text = &$vars['content']['spotlight_hero_text'];

    foreach ($spotlight_hero_text as $key => $field) {
      if (!empty($field['content'][0]) && $field['content'][0]['#field_name'] == 'su_spotlight_degrees') {
        $degrees = &$spotlight_hero_text[$key];

      }
      if (!empty($field['content'][0]) && $field['content'][0]['#field_name'] == 'su_soe_department') {
        $department = &$spotlight_hero_text[$key];
        $department_key = $key;
      }
    }

    if (!empty($degrees) && !empty($department)) {
      // We need to concat the values.
      $degrees_text = $degrees['content'][0][0]['#context']['value'];
      $department_text = $department['content'][0][0]['#plain_text'];
      $final_value = $degrees_text . ', ' . $department_text;
      $degrees['content'][0][0]['#context']['value'] = $final_value;
      // Get rid of the department field, since we now have this data in
      // the Degrees field.
      unset($spotlight_hero_text[$department_key]);
    }
  }
}


/**
 * implements hook_update_n
 */
function engineering_profile_helper_update_8201(&$sandbox) {
  $modules = ['fontawesome'];
  \Drupal::database()->delete('key_value')
    ->condition('collection', 'system.schema')
    ->condition('name', $modules, 'IN')
    ->execute();
}

/**
 * Implements hook_local_tasks_alter().
 */
function engineering_profile_helper_local_tasks_alter(&$local_tasks) {
  // Remove Layout Builder local task for user entities if Layout Builder is not enabled.
  if (isset($local_tasks['layout_builder_ui:layout_builder.overrides.user.view'])) {
    $entity_view_display_storage = \Drupal::entityTypeManager()->getStorage('entity_view_display');
    $user_displays = $entity_view_display_storage->loadByProperties(['targetEntityType' => 'user']);
    
    $layout_builder_enabled = FALSE;
    foreach ($user_displays as $display) {
      // Check if the display implements LayoutEntityDisplayInterface before calling isLayoutBuilderEnabled().
      if ($display instanceof \Drupal\layout_builder\Entity\LayoutEntityDisplayInterface && $display->isLayoutBuilderEnabled()) {
        $layout_builder_enabled = TRUE;
        break;
      }
    }
    
    // Remove the local task if Layout Builder is not enabled for any user display.
    if (!$layout_builder_enabled) {
      unset($local_tasks['layout_builder_ui:layout_builder.overrides.user.view']);
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for media_library_add_form_upload.
 *
 * Attaches JS that disables the "Upload and Continue" button while the
 * dropzone async upload is still in progress, preventing a race condition
 * where the form submits before the uploaded file is ready.
 *
 * @see \Drupal\stanford_media\Form\MediaLibraryFileUploadForm
 */
function engineering_profile_helper_form_media_library_add_form_upload_alter(array &$form, FormStateInterface $form_state) {
  $form['#attached']['library'][] = 'engineering_profile_helper/dropzone-upload-guard';
}

/**
 * Implements hook_entity_view_display_presave().
 *
 * This runs before other modules' entity_view_display hooks.
 */
function engineering_profile_helper_entity_view_display_presave(EntityViewDisplayInterface $display) {
  // During config sync, ensure Layout Builder entity type alterations are applied.
  if (\Drupal::isConfigSyncing() && \Drupal::moduleHandler()->moduleExists('layout_builder')) {
    // Clear cached entity type definitions to ensure Layout Builder's alterations are applied.
    \Drupal::entityTypeManager()->clearCachedDefinitions();
  }
}
